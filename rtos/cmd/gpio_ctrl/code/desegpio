# gpio_control_deserialize_gpios

# is packet empty?
packet_size = packet.size
~ packet_size == 0 && exit

buf_size -= 4
payload_i = 0

while buf_size > 1 && packet_size > 1:
  led_i = packet.payload[payload_i] - 1
  ~ led_i < 3:
    led = leds[led_i]
    state = led.states[0]

    old_gpio = state.gpio
    new_gpio = packet.payload[payload_i + 1]

    ~ (new_gpio == 18 || new_gpio != old_gpio) && old_gpio != 18:
      gpio_control_callback(old_gpio)  # see `callback`

    for state_i in 0..8:
      state = led.states[state_i]
      state.gpio = new_gpio

  buf_size -= 2
  packet_size -= 2
  payload_i += 2
